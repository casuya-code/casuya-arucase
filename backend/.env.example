# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=arucase

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRES=5m

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=16777216

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Cloudinary Configuration (legacy gallery photos + GIF uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Cloudflare R2 Configuration (new gallery uploads)
# Create a bucket + R2 API token in the Cloudflare dashboard, then fill these in.
# R2_PUBLIC_BASE_URL is the bucket's public origin, e.g. https://pub-xxxx.r2.dev
# or a custom domain such as https://media.arushacatholicseminary.co.tz
R2_ACCOUNT_ID=de02bd0e1be4fc699d9003ad1eae5e2f
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# API Caching (Optional)
CACHE_TTL_SECONDS=300
CACHE_MAX_KEYS=500

# Backup
BACKUP_RETENTION_DAYS=60
BACKUP_MAX_FILES=20
BACKUP_CLOUDINARY_SYNC=true
BACKUP_VERIFY=true
